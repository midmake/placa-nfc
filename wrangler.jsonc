{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "placa-nfc",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "keep_vars": true,
  // Only the application subdomain; root, mail and other DNS stay untouched.
  "routes": [{ "pattern": "app.geargo.com.br", "custom_domain": true }],
  // Official HTTPS login and existing-plate QR confirmed by owner on 2026-10-06.
  "vars": {
    "PUBLIC_BASE_URL": "https://app.geargo.com.br",
    "QR_PRODUCTION_READY": "true"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "placa-nfc",
      "database_id": "bc6f8a86-9019-4fbb-ba3f-eaaf79d5378e",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": false },
}
